# ============================================================
# Database Configuration
# ============================================================
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/database"

# ============================================================
# Redis Configuration
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ============================================================
# Application Configuration
# ============================================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ============================================================
# JWT Configuration
# ============================================================
JWT_SECRET=your_jwt_secret_key_min_32_characters
JWT_EXPIRES_IN=4h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# Shopee Open API Configuration
# ============================================================
# Test Environment (Sandbox)
SHOPEE_TEST_PARTNER_ID=your_test_partner_id
SHOPEE_TEST_PARTNER_KEY=your_test_partner_key
SHOPEE_TEST_BASE_URL=https://openplatform.sandbox.test-stable.shopee.sg

# Production Environment
SHOPEE_PARTNER_ID=your_live_partner_id
SHOPEE_PARTNER_KEY=your_live_partner_key
SHOPEE_BASE_URL=https://partner.shopeemobile.com

# OAuth Redirect URL
SHOPEE_REDIRECT_URL=http://localhost:3001/api/v1/marketplace/shopee/callback

# ============================================================
# Email Configuration (Optional)
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=noreply@yourdomain.com

# ============================================================
# Storage Configuration (Optional)
# ============================================================
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# AWS S3 (if using cloud storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your_bucket_name
