# Application
NODE_ENV=development
APP_NAME="Omnichannel Marketplace API"
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database
# Local PostgreSQL:
DATABASE_URL="postgresql://omnichannel:omnichannel_secret@localhost:5432/omnichannel_db"
DIRECT_URL="postgresql://omnichannel:omnichannel_secret@localhost:5432/omnichannel_db"

# Supabase:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_REMEMBER_EXPIRES=30d

# Email (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Omnichannel <noreply@omnichannel.com>"

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=omnichannel
MINIO_USE_SSL=false

# Shopee API
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_API_URL=https://partner.shopeemobile.com
SHOPEE_BASE_URL=https://partner.shopeemobile.com

# Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Webhook
WEBHOOK_SECRET=your-webhook-secret
