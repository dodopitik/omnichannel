FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
RUN npm install -g turbo

FROM base AS development
COPY package.json package-lock.json turbo.json ./
COPY apps/webhook/package.json ./apps/webhook/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/shared/package.json ./packages/shared/package.json
RUN npm ci
COPY . .
EXPOSE 3003
CMD ["npm", "run", "dev", "--workspace=apps/webhook"]

FROM base AS builder
COPY package.json package-lock.json turbo.json ./
COPY apps/webhook/package.json ./apps/webhook/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/shared/package.json ./packages/shared/package.json
RUN npm ci
COPY . .
RUN turbo run build --filter=webhook...

FROM node:20-alpine AS production
RUN apk add --no-cache openssl
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/apps/webhook/dist ./dist
COPY --from=builder /app/apps/webhook/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
EXPOSE 3003
CMD ["node", "dist/main"]
